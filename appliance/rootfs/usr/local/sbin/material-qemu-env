#!/bin/sh
# Resolve this appliance's LAN address and write the runtime environment.
# The web service only answers requests whose Host matches PUBLIC_ORIGIN,
# so the origin is derived from the address the network actually assigned.
# Only real network interfaces count: Docker's own bridge (docker0, br-*,
# veth*) is never a LAN address.
set -eu
port=8080
lan_ip() {
  # Prefer the source address of the default route, then any global IPv4 on
  # a physical-looking interface (en*, eth*).
  ip -4 -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).* src \([0-9.]*\).*/\1 \2/p' |
    while read -r dev addr; do case "$dev" in en*|eth*) echo "$addr" ;; esac; done | head -n1
}
lan_ip_any() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{print $2, $4}' |
    while read -r dev cidr; do case "$dev" in en*|eth*) echo "${cidr%/*}" ;; esac; done | head -n1
}
ip=""
i=0
while [ "$i" -lt 240 ]; do
  ip=$(lan_ip || true)
  [ -n "$ip" ] || ip=$(lan_ip_any || true)
  [ -n "$ip" ] && break
  i=$((i + 1))
  sleep 1
done
if [ -z "$ip" ]; then
  echo "material-qemu: no LAN address was assigned to a network interface" >&2
  printf 'MQ-FAILED reason=no-lan-address\r\n' > /dev/ttyS0 2>/dev/null || true
  exit 1
fi
origin="http://$ip:$port"
if [ -s /etc/material-qemu/public-origin ]; then
  origin=$(head -n1 /etc/material-qemu/public-origin)
fi
umask 022
printf 'PUBLIC_ORIGIN=%s\nMQ_IP=%s\nMQ_PORT=%s\n' "$origin" "$ip" "$port" > /run/material-qemu.env
