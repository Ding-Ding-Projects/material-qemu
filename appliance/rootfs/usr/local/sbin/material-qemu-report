#!/bin/sh
# Wait for the web service to become healthy, then report its address on the
# first serial port (read by the deploy app) and on the local console.
set -u
. /run/material-qemu.env
host=$(printf '%s' "$PUBLIC_ORIGIN" | sed 's#^[a-z]*://##; s#/.*##')
version=$(cat /opt/material-qemu/version 2>/dev/null || echo unknown)
serial() {
  for port in /dev/ttyS0; do
    [ -c "$port" ] && printf '%s\r\n' "$1" > "$port" 2>/dev/null || true
  done
}
rootsize=$(df -h / | awk 'NR==2{print $2}')
serial "MQ-BOOT version=$version ip=$MQ_IP root=$rootsize"
healthy=0
i=0
while [ "$i" -lt 900 ]; do
  if curl -fsS --max-time 3 -H "Host: $host" "http://127.0.0.1:$MQ_PORT/health" >/dev/null 2>&1; then
    healthy=1
    break
  fi
  i=$((i + 1))
  sleep 1
done
mkdir -p /etc/issue.d
if [ "$healthy" -ne 1 ]; then
  # Put the evidence where the deploy app and the build's boot check can read it.
  {
    echo "MQ-DIAG systemctl status:"
    systemctl --no-pager --lines=0 status docker material-qemu-load material-qemu 2>&1 | head -n 30
    echo "MQ-DIAG journal:"
    journalctl --no-pager -n 40 -u material-qemu -u material-qemu-load -u docker 2>&1 | tail -n 40
    echo "MQ-DIAG containers:"
    docker ps -a 2>&1 | head -n 10
  } | while IFS= read -r l; do serial "MQ-DIAG $l"; done
  serial "MQ-FAILED version=$version reason=health-timeout"
  printf 'Material QEMU did not become healthy. Check: journalctl -u material-qemu\n\n' > /etc/issue.d/material-qemu.issue
  exit 1
fi
serial "MQ-READY version=$version url=$PUBLIC_ORIGIN/"
{
  printf 'Material QEMU %s is running.\n' "$version"
  printf 'Open %s/ from a browser on your network.\n' "$PUBLIC_ORIGIN"
  printf 'The first account created there becomes the owner.\n'
  printf '\n'
} > /etc/issue.d/material-qemu.issue
exit 0
