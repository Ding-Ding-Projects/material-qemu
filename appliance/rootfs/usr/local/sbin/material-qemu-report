#!/bin/sh
# Wait for the web service to become healthy, then report its address on the
# first serial port (read by the deploy app) and on the local console.
set -u
# Keep kernel messages (Docker bridge changes and the like) off the screen so
# the address shown at the login prompt stays readable.
dmesg -n 3 2>/dev/null || true
. /run/material-qemu.env
host=$(printf '%s' "$PUBLIC_ORIGIN" | sed 's#^[a-z]*://##; s#/.*##')
version=$(cat /opt/material-qemu/version 2>/dev/null || echo unknown)
serial() {
  for port in /dev/ttyS0; do
    [ -c "$port" ] && printf '%s\r\n' "$1" > "$port" 2>/dev/null || true
  done
}
rootsize=$(df -h / | awk 'NR==2{print $2}')
serial "MQ-BOOT version=$version ip=$MQ_IP root=$rootsize"
# The network interface that holds the address. The login screen shows that
# interface's address through agetty's \4{interface} escape, so the line
# stays right if the network hands out a new address; naming the interface
# keeps Docker's own bridge address off the screen.
iface=$(ip -4 -o addr show 2>/dev/null | awk -v want="$MQ_IP" '{split($4, a, "/"); if (a[1] == want) {print $2; exit}}')
ip_line() {
  if [ -n "$iface" ]; then
    printf 'IP address: \\4{%s}\n' "$iface"
  else
    printf 'IP address: %s\n' "$MQ_IP"
  fi
}
# Write the login screen text (a heading, the IP address, then up to two
# more lines) and redraw the screen so it shows at once.
show() {
  mkdir -p /etc/issue.d
  {
    printf '%s\n' "$1"
    ip_line
    [ -n "${2:-}" ] && printf '%s\n' "$2"
    [ -n "${3:-}" ] && printf '%s\n' "$3"
    printf '\n'
  } > /etc/issue.d/material-qemu.issue
  systemctl restart getty@tty1.service 2>/dev/null || true
}
show "Material QEMU $version is starting." "The web page opens at $PUBLIC_ORIGIN/ once it is ready."
healthy=0
i=0
while [ "$i" -lt 900 ]; do
  if curl -fsS --max-time 3 -H "Host: $host" "http://127.0.0.1:$MQ_PORT/health" >/dev/null 2>&1; then
    healthy=1
    break
  fi
  i=$((i + 1))
  sleep 1
done
if [ "$healthy" -ne 1 ]; then
  # Put the evidence where the deploy app and the build's boot check can read it.
  {
    echo "MQ-DIAG systemctl status:"
    systemctl --no-pager --lines=0 status docker material-qemu-load material-qemu 2>&1 | head -n 30
    echo "MQ-DIAG journal:"
    journalctl --no-pager -n 40 -u material-qemu -u material-qemu-load -u docker 2>&1 | tail -n 40
    echo "MQ-DIAG containers:"
    docker ps -a 2>&1 | head -n 10
  } | while IFS= read -r l; do serial "MQ-DIAG $l"; done
  serial "MQ-FAILED version=$version reason=health-timeout"
  show "Material QEMU $version did not become healthy." "Check: journalctl -u material-qemu"
  exit 1
fi
serial "MQ-READY version=$version url=$PUBLIC_ORIGIN/"
show "Material QEMU $version is running." "Open $PUBLIC_ORIGIN/ from a browser on your network." "The first account created there becomes the owner."
exit 0
