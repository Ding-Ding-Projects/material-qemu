[Unit]
Description=Material QEMU web service
Requires=docker.service
Wants=network-online.target material-qemu-load.service
After=docker.service network-online.target material-qemu-load.service

[Service]
EnvironmentFile=/opt/material-qemu/image.env
ExecStartPre=/usr/local/sbin/material-qemu-env
ExecStartPre=-/usr/bin/docker rm -f material-qemu
ExecStart=/usr/bin/docker run --rm --name material-qemu --env-file /run/material-qemu.env -p 8080:8080 -v material-qemu-data:/data --cap-drop ALL --security-opt no-new-privileges:true --stop-timeout 30 ${MQ_IMAGE}
ExecStop=/usr/bin/docker stop -t 30 material-qemu
Restart=on-failure
RestartSec=5
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
