[Unit]
Description=Watch for Material QEMU update requests
# No ordering after docker.service: path units run before basic.target, and
# Docker starts after it, so that ordering would form a cycle that systemd
# breaks by dropping the web service from the boot.

[Path]
PathExists=/var/lib/docker/volumes/material-qemu-data/_data/update-request
Unit=material-qemu-update.service

[Install]
WantedBy=multi-user.target
