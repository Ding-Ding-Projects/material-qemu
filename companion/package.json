{
  "name": "material-qemu-deploy",
  "productName": "Material QEMU Deploy",
  "version": "0.1.0",
  "private": true,
  "description": "One-click VirtualBox and VMware hosting for the Material QEMU appliance",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.dingdingprojects.materialqemu.deploy",
    "productName": "Material QEMU Deploy",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "lib/**", "renderer/**", "package.json", "node_modules/@fontsource-variable/roboto-flex/files/roboto-flex-latin-wght-normal.woff2"],
    "win": { "target": ["portable"] },
    "portable": { "artifactName": "material-qemu-deploy-${version}-portable.exe" }
  }
}
